{
  "comfy_base_url": "http://127.0.0.1:8188",
  "comfy_output_root": "/content/ComfyUI/output",
  "workflow_path": "workflows/h3_api.json",
  "output_dir": "runs",
  "clip_seconds": 8,
  "frames_per_review_second": 1,
  "max_retries": 3,
  "review_thresholds": {
    "identity": 0.88,
    "seam_continuity": 0.80,
    "average": 0.82
  },
  "llm": {
    "base_url": "https://YOUR_LLM_ENDPOINT/v1",
    "endpoint": "/chat/completions",
    "api_key_env": "LLM_API_KEY",
    "model": "YOUR_MULTIMODAL_MODEL",
    "timeout_seconds": 180
  },
  "workflow_bindings": {
    "prompt": {"node_id": "PROMPT_NODE_ID", "input": "text"},
    "seed": {"node_id": "SEED_NODE_ID", "input": "seed"},
    "output_prefix": {"node_id": "SAVE_NODE_ID", "input": "filename_prefix"}
  }
}
