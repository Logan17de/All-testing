{
  "name": "@zet-harness/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm --prefix ../.. run build --workspace @zet-harness/plugin-api && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:plugin-smoke": "vitest run src/plugin-parity.test.ts"
  },
  "dependencies": {
    "@zet-harness/plugin-api": "0.0.0"
  }
}
