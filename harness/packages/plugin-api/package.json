{
  "name": "@zet-harness/plugin-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node-behavior-policy": {
      "types": "./src/node-behavior-policy.ts",
      "default": "./dist/node-behavior-policy.js"
    },
    "./secret-contract": {
      "types": "./src/secret-contract.ts",
      "default": "./dist/secret-contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  }
}
