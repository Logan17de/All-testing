# Zet Harness environment template
# Copy this file to `.env.local` for local development.
# Never commit real credentials, tokens, or machine-specific secrets.

# App
NEXT_PUBLIC_APP_NAME=Zet Harness
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local persistence
HARNESS_DATA_DIR=./data
HARNESS_DB_PATH=./data/zet-harness.db

# OpenAI-compatible model provider (configured in Phase 2)
OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
OPENAI_COMPAT_API_KEY=<API_KEY>
OPENAI_COMPAT_MODEL=<MODEL_ID>

# External client authentication (configured in Phase 9)
HARNESS_CLIENT_TOKEN=<RANDOM_SECRET>
