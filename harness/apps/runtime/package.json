{
  "name": "@zet-harness/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix ../.. run build --workspace @zet-harness/db --workspace @zet-harness/scheduler --workspace @zet-harness/plugin-api --workspace @zet-harness/core --workspace @zet-harness/plugin-loader --workspace @zet-harness/graph && tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@zet-harness/db": "0.0.0",
    "@zet-harness/scheduler": "0.0.0",
    "@zet-harness/plugin-loader": "0.0.0",
    "@zet-harness/core": "0.0.0",
    "@zet-harness/plugin-api": "0.0.0",
    "@zet-harness/graph": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
