{
  "name": "harness-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A self-contained Windows desktop shell for DeepSeek Harness with safe plugin staging and rollback.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "adm-zip": "0.5.16",
    "pnpm": "11.24.0"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.harnessdesktop.app",
    "productName": "Harness Desktop",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Harness-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Harness Desktop"
    }
  }
}
