{
  "name": "dsh-copycat-chatgpt-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bidirectional local bridge between DeepSeek Harness and a normal ChatGPT browser session through Copycat.",
  "type": "module",
  "main": "./index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "harnessDesktop": {
    "permissions": [
      "network",
      "filesystem",
      "workspace"
    ]
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
